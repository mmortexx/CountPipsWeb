# Cabeceras HTTP — las lee Cloudflare Pages desde la raíz del sitio
# publicado. GitHub Pages ignora este fichero por completo (no permite
# configurar cabeceras), así que aquí no hay nada que pueda romper la
# publicación antigua: o se aplica, o se ignora.
#
# Este fichero vive en `public/` para que el export lo copie tal cual a
# `out/`, que es lo que Cloudflare publica.

# ── Seguridad, en todo el sitio ───────────────────────────────────────
/*
  # Impide que el sitio se cargue dentro de un iframe ajeno. Sin esto,
  # cualquiera puede incrustar la página en la suya y superponer sus
  # propios controles encima de los botones reales — es como se roban
  # clics de compra.
  X-Frame-Options: DENY
  # El navegador respeta el tipo de contenido declarado en vez de
  # intentar adivinarlo. Evita que un fichero subido como imagen acabe
  # ejecutándose como script.
  X-Content-Type-Options: nosniff
  # Al salir hacia otro dominio solo se envía el origen, nunca la ruta
  # completa: la página concreta que estaba viendo el visitante no viaja
  # a terceros.
  Referrer-Policy: strict-origin-when-cross-origin
  # Se renuncia explícitamente a permisos que este sitio no usa. Si
  # alguna dependencia intentara pedir cámara o micrófono, el navegador
  # lo deniega sin preguntar al visitante.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  # Le dice al navegador que memorice, un año entero, que este dominio se
  # sirve por HTTPS y que nunca debe intentar la versión sin cifrar — ni
  # siquiera si alguien teclea `http://` a mano o un enlace viejo lo
  # apunta ahí. Cloudflare Pages ya fuerza HTTPS por su cuenta; esto
  # cierra el instante entre la primera petición y esa redirección, que
  # es donde un atacante en la misma red podría interceptar la conexión
  # sin cifrar antes de que llegue a redirigirse.
  #
  # SIN `preload`, a propósito. Ese añadido somete el dominio a una lista
  # que llevan los propios navegadores, y salir de ella una vez dentro es
  # cosa de meses, no de un despliegue. Se añade el día que el dominio
  # esté ya estable en `countpips.com`, como paso deliberado y no como
  # efecto secundario de esta cabecera.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Restringe desde dónde puede cargar el sitio scripts, estilos,
  # conexiones y frames, a los dominios que el sitio usa de verdad:
  # Turnstile (verificación anti-bot de /beta), PostHog EU (analítica con
  # consentimiento), Web3Forms (contacto/newsletter) y el Apps Script de
  # Google (lista de espera y su fallback de /beta). Todo lo demás queda
  # bloqueado — así un XSS reflejado o almacenado no puede cargar un
  # <script src="dominio-arbitrario">.
  #
  # 'unsafe-inline' en script-src y style-src es una concesión deliberada,
  # no un descuido: esta es una exportación estática de Next.js App
  # Router (output: "export"), que hornea en cada página scripts inline
  # sin nonce (hidratación RSC, anti-FOUC de tema, corrección de idioma
  # bajo /en) y atributos style="" inline (gradientes, Framer Motion). Sin
  # servidor dinámico no hay forma de emitir un nonce por petición, y
  # enumerar hashes para docenas de scripts que cambian en cada build no
  # es viable sin tooling adicional.
  #
  # EL WORKER DE ACCESO ANTICIPADO, YA CONTEMPLADO.
  #
  # Aquí ponía "PENDIENTE: cuando NEXT_PUBLIC_BETA_API_URL apunte al
  # Worker, ese origen debe añadirse a connect-src". Dejarlo pendiente
  # era una bomba con la mecha encendida: el día que se configure esa
  # variable, el formulario de /beta empezaría a fallar EN EL ACTO y con
  # un error de red genérico — el visitante ve "no hemos podido
  # conectar", la consola dice que la CSP lo bloqueó, y nada en el
  # despliegue lo avisa. Y ese día es justo el de estrenar el panel de
  # solicitudes, cuando menos ganas hay de depurar cabeceras.
  #
  # `https://*.workers.dev` cubre la dirección por defecto del Worker
  # (`countpips-beta-api.<subdominio>.workers.dev`, ver
  # services/beta-api/wrangler.jsonc). Es un comodín de un solo nivel
  # bajo un dominio de Cloudflare, no un `*` abierto: sigue prohibiendo
  # cualquier otro destino. Cuando el Worker tenga dominio propio, se
  # añade aquí ese origen y se puede retirar el comodín.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://eu-assets.i.posthog.com https://script.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.web3forms.com https://script.google.com https://challenges.cloudflare.com https://eu.i.posthog.com https://*.workers.dev https://api.countpips.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

  # ── CACHÉ POR DEFECTO: NO CACHEAR ───────────────────────────────────
  # Va aquí, en la regla que casa con TODO, y las reglas de abajo la
  # levantan para lo que sí se puede cachear. El orden importa: en este
  # fichero, cuando dos reglas casan, gana la última, así que la general
  # tiene que ir primero.
  #
  # Antes esto era una regla `/*.html` al final del fichero, y NO CASABA
  # NUNCA. Cloudflare compara el patrón contra la ruta que pide el
  # navegador, no contra el fichero que acaba sirviendo: con
  # `trailingSlash: true` las direcciones de este sitio son `/features/`
  # y `/`, jamás `/features.html`. El HTML se quedaba sin política de
  # caché y un despliegue podía tardar en verse sin que nada lo
  # explicara.
  Cache-Control: public, max-age=0, must-revalidate

# ── Recursos con huella en el nombre ──────────────────────────────────
# Next incrusta un hash en el nombre de cada fichero de `_next/static`,
# así que un cambio de contenido SIEMPRE cambia el nombre. Eso permite
# cachearlos un año sin riesgo de servir algo viejo: si cambia, la página
# pedirá otro nombre. `immutable` le dice al navegador que ni se moleste
# en revalidar.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Las imágenes y fuentes no llevan huella en el nombre, así que se
# cachean un día y se revalidan. Un mes sería arriesgado: cambiar una
# captura dejaría a los visitantes recurrentes viendo la anterior.
/img/*
  Cache-Control: public, max-age=86400, must-revalidate

# ── Las tarjetas para compartir en redes ──────────────────────────────
# Next genera estas imágenes SIN extensión en el nombre: el fichero se
# llama `opengraph-image` a secas, no `opengraph-image.png`. Los
# servidores estáticos deducen el tipo de la extensión, así que sin ella
# lo normal es que salgan anunciadas como binario genérico. Y arriba se
# declara `nosniff`, que prohíbe expresamente al navegador corregir esa
# deducción mirando el contenido — de modo que la protección de seguridad
# y la falta de extensión se agravan mutuamente.
#
# Facebook, WhatsApp, LinkedIn y X descartan la miniatura cuando el tipo
# anunciado no es de imagen. El resultado sería el peor posible: la
# imagen existe, es correcta, pesa 67 KB y se generó bien, pero ningún
# enlace compartido la enseña — y nada en la compilación lo delata.
/*opengraph-image
  Content-Type: image/png
/*twitter-image
  Content-Type: image/png

# (La política de caché del HTML vive arriba, dentro del bloque `/*`.
#  Ver la nota que hay allí sobre por qué la regla `/*.html` que había
#  aquí no llegaba a aplicarse nunca.)
