{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "countpips-beta-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-05",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "ENVIRONMENT": "production",
    "RATE_LIMIT_SECONDS": "60",
    // Cuota diaria por IP, además de la ventana corta de arriba. Sin ella,
    // mil peticiones espaciadas 61 segundos son mil peticiones.
    "RATE_LIMIT_DAILY": "20",
    // `http://localhost:3000` estaba en esta lista, que es la de
    // PRODUCCIÓN: una página abierta en el equipo de cualquiera podía
    // escribir en la base de datos real. Para desarrollo local se declara
    // en `.dev.vars` (que ya está fuera del control de versiones), no
    // aquí.
    "ALLOWED_ORIGINS": "https://mmortexx.github.io,https://countpips.com,https://www.countpips.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "countpips-beta",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
